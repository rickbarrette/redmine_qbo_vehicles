<%= error_messages_for 'vehicle' %>

<% if @existing_vehicle %>
  <div class="flash warning">
    <%= l(:text_vin_already_on_file) %>
    <%= link_to @existing_vehicle.to_s, vehicle_path(@existing_vehicle) %>
  </div>
<% end %>

<div class="box tabular">
  <p>
    <%# Customer autocomplete from redmine_qbo: fills the hidden customer_id %>
    <%= f.text_field :customer, label: :field_customer, required: true, size: 60,
                     value: @vehicle.customer&.name, class: 'customer-name', autocomplete: 'off',
                     data: { autocomplete_url: '/customers/autocomplete' } %>
    <%= f.hidden_field :customer_id, id: 'customer_id' %>
  </p>
  <p><%= f.text_field :vin, label: :field_vin, required: true, size: 20, maxlength: 17, autofocus: true %></p>
  <p><%= f.number_field :year, label: :label_year, min: 1900, max: Date.today.year + 2, autocomplete: 'off' %></p>
  <p><%= f.text_field :make, label: :label_make, size: 30, autocomplete: 'off' %></p>
  <p><%= f.text_field :model, label: :label_model, size: 30, autocomplete: 'off' %></p>
  <p>
    <%= f.text_area :notes, label: :field_notes, rows: 8, class: 'wiki-edit', id: 'vehicle_notes' %>
    <%= wikitoolbar_for 'vehicle_notes' %>
  </p>
</div>
