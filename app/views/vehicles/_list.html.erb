<% if vehicles.present? %>

  <%# A vehicle: the checkbox and its name, then its VIN and when it was last serviced, each on its own line (style.css) %>
  <div class="vehicle-list">
  <% vehicles.each do |vehicle| %>
    <div class="vehicle-row">
      <span class="vehicle-check">
        <% if show_checkbox %>
          <%# Ticking a vehicle adds it to the customer page's New issue and Add appointment links (redmine_qbo's customers/_new_issue_link_script) %>
          <%= check_box_tag "vehicle_ids[]", vehicle.id, false, data: { ticked_field: 'vehicle_id' }, class: "vehicle-checkbox" %>
        <% end %>
      </span>
      <div class="vehicle-text">
        <div class="vehicle-name"><%= link_to vehicle.to_s, vehicle_path(vehicle) %></div>
        <div class="vehicle-details">
          <%= render partial: 'vehicles/vin', locals: { vin: vehicle.vin } %>
          <% if show_customer %>
            <span class="vehicle-detail"><%= vehicle.customer %></span>
          <% end %>
          <% if (mileage = vehicle.last_service_mileage) %>
            <span class="vehicle-detail"><b><%= t(:label_last_service) %></b> <%= vehicle.last_service_date %> at <%= mileage %> <%= t(:label_miles) %></span>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  </div>

  <%# pages: a Redmine::Pagination::Paginator for the list (count: how many in all); per_page_links: false to leave out "Per page" %>
  <% if local_assigns[:pages] %>
    <span class="pagination"><%= pagination_links_full pages, count, per_page_links: local_assigns[:per_page_links] %></span>
  <% end %>

<%=t(:label_matching)%> <%= local_assigns[:count] || vehicles.size %> <%=t(:field_vehicles) %>

<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
