<h2><%= link_to l(:field_vehicles), vehicles_path %> &#187; <%= l(:label_new_vehicle) %></h2>

<%= labelled_form_for @vehicle do |f| %>
  <%# Where to go back to, and what the vehicle is being added for (see VehiclesController#create) %>
  <%= back_url_hidden_field_tag %>
  <%= hidden_field_tag 'appointment_id', params[:appointment_id] if params[:appointment_id].present? %>
  <%= render partial: 'vehicles/form', locals: { f: f } %>
  <%= submit_tag l(:button_create) %>
  <%= link_to l(:button_cancel), validate_back_url(params[:back_url].to_s) || (@vehicle.customer ? customer_path(@vehicle.customer) : vehicles_path) %>
<% end %>

<% html_title(l(:label_new_vehicle)) -%>
