<%#
  Copies a VIN (vehicles/_vin) when it's clicked or activated with Enter/Space. Written into the page
  head by the layout hook rather than served as a compiled asset, so it can't 404 when Redmine's asset
  manifest is out of date. One listener on the page handles every VIN, including ones added later.
%>
<style>
  .vehicle-vin { cursor: pointer; display: inline-block; }
</style>
<%= javascript_tag do %>
(function () {
  var COPIED = <%= raw l(:text_copied).to_json %>;
  var FAILED = <%= raw l(:text_copy_failed).to_json %>;

  // Clipboard API where available (HTTPS); falls back to the older copy command otherwise
  function copyText(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function (resolve, reject) {
      var area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
      document.body.removeChild(area);
      ok ? resolve() : reject(new Error('copy command failed'));
    });
  }

  function copyVin(el) {
    if (el.dataset.copyBusy === '1') return;
    el.dataset.copyBusy = '1';
    var original = el.innerHTML;

    function flash(message, color) {
      el.innerHTML = '<b>' + message + '</b>';
      el.style.color = color;
      setTimeout(function () {
        el.innerHTML = original;
        el.style.color = '';
        el.dataset.copyBusy = '';
      }, 2000);
    }

    copyText(el.dataset.vin).then(
      function () { flash(COPIED, '#2e7d32'); },
      function (err) {
        console.error('Unable to copy VIN', err);
        flash(FAILED, '#c62828');
      }
    );
  }

  document.addEventListener('click', function (e) {
    var el = e.target.closest && e.target.closest('.vehicle-vin[data-vin]');
    if (el) copyVin(el);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var el = e.target.closest && e.target.closest('.vehicle-vin[data-vin]');
    if (!el) return;
    e.preventDefault();
    copyVin(el);
  });
})();
<% end %>
