<%= render partial: 'vehicles/trail', locals: { vehicle: @vehicle, tail: link_to(@vehicle.to_s, vehicle_path(@vehicle)) } %>

<%= labelled_form_for @vehicle do |f| %>
  <%= render partial: 'vehicles/form', locals: { f: f } %>
  <%= submit_tag l(:button_save) %>
  <%= link_to l(:button_cancel), vehicle_path(@vehicle) %>
<% end %>

<% html_title(l(:label_edit_customer_vehicle)) -%>
